{% comment %}
  VII — the only centred section on the site, so it steps outside the
  asymmetric drawing-sheet grid deliberately.
{% endcomment %}
<section id="access" class="access" aria-labelledby="access-heading">
  <div class="access__inner">
    <div class="reveal access__aside">
      <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
      <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
    </div>

    <div class="reveal access__heading" style="--reveal-delay: 100ms;">
      <h2 id="access-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="reveal access__lead" style="--reveal-delay: 200ms;">
      <p>{{ section.settings.lead }}</p>
    </div>

    <div class="reveal access__note" style="--reveal-delay: 300ms;">
      <p>{{ section.settings.note }}</p>
    </div>

    <div class="reveal access__cta" style="--reveal-delay: 400ms;">
      <a href="{{ section.settings.link }}" class="door-link label-t">
        {{- section.settings.link_label | escape -}}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TAIYIB access",
  "settings": [
    { "type": "text", "id": "numeral", "label": "Numeral", "default": "VII" },
    { "type": "text", "id": "label", "label": "Section label", "default": "Access" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The door is open." },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Lead",
      "default": "<p>There is no list, no referral, no membership. Everything is available to anyone who wants it.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p>That has never been the same thing as being for everyone.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Enter the house" },
    { "type": "text", "id": "link", "label": "Link", "default": "mailto:atelier@taiyib.com" }
  ],
  "presets": [{ "name": "TAIYIB access" }]
}
{% endschema %}
