<section id="tib" class="t-sheet" aria-labelledby="tib-heading">
  <div class="t-gutter">
    <div class="t-sheet__row">
      <div class="reveal t-sheet__aside">
        <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
        <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
      </div>

      <div class="t-sheet__body">
        <div class="reveal">
          <h2 id="tib-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
        </div>

        {% comment %}
          rtl is scoped to an inline-block so the word sits at the start of the
          measure rather than being flung to the right edge of the column.
        {% endcomment %}
        <div class="reveal t-mt-arabic" style="--reveal-delay: 100ms;">
          <p>
            <span dir="rtl" lang="ar" class="tib-word">{{ section.settings.arabic }}</span>
          </p>
        </div>

        <div class="t-stack t-mt-tib-prose">
          {%- for block in section.blocks -%}
            {%- if block.type == 'paragraph' -%}
              <div class="reveal" style="--reveal-delay: {{ forloop.index | times: 80 | plus: 80 }}ms;" {{ block.shopify_attributes }}>
                <p class="prose-t t-prose">{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="flacon">
          {% comment %} One tall column, not a grid of three {% endcomment %}
          <div class="reveal flacon__panel" style="--reveal-delay: 80ms;">
            <div class="sweep flacon__card">
              <div class="flacon__head">
                <h3 class="wordmark">{{ section.settings.flacon_name | escape }}</h3>
                <p dir="rtl" lang="ar">{{ section.settings.flacon_arabic }}</p>
              </div>

              <dl>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'row' -%}
                    <div class="flacon__row" {{ block.shopify_attributes }}>
                      <dt class="label-t">{{ block.settings.term | escape }}</dt>
                      <dd class="num">{{ block.settings.value | escape }}</dd>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </dl>
            </div>
          </div>

          <div class="reveal is-image flacon__media" style="--reveal-delay: 200ms;">
            {% render 'taiyib-plate',
              image: section.settings.image,
              fallback: 'taiyib-tib-flacon.png',
              width: 1024,
              height: 1024,
              alt: section.settings.image_alt,
              caption: section.settings.image_caption,
              ratio_class: 'aspect-portrait',
              sizes: '(max-width: 820px) 100vw, 28rem'
            %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

