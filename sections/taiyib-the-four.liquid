{% comment %}
  An archival ledger, not cards. Rows separated by hairlines; each row is a
  4-column grid of index, name, specification and price.
{% endcomment %}
<section id="the-four" class="t-sheet" aria-labelledby="the-four-heading">
  <div class="t-gutter">
    <div class="t-sheet__row">
      <div class="reveal t-sheet__aside">
        <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
        <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
      </div>

      <div class="t-sheet__body">
        <div class="reveal">
          <h2 id="the-four-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
        </div>

        <div class="reveal t-mt-lead" style="--reveal-delay: 100ms;">
          <p class="prose-t t-prose">{{ section.settings.intro }}</p>
        </div>

        <div class="reveal t-mt-block" style="--reveal-delay: 200ms;">
          <div class="ledger">
            {%- for block in section.blocks -%}
              <article class="ledger-row" {{ block.shopify_attributes }}>
                <span class="ledger-index label-t num" aria-hidden="true">
                  {{- block.settings.index | escape -}}
                </span>

                <h3 class="ledger-name">{{ block.settings.name | escape }}</h3>

                <div class="ledger-detail">
                  <p class="label-t ledger-category">{{ block.settings.category | escape }}</p>
                  <p class="ledger-spec">{{ block.settings.spec | escape }}</p>
                </div>

                <p class="num ledger-price">{{ block.settings.price | escape }}</p>
              </article>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.footnote != blank -%}
          <div class="reveal" style="--reveal-delay: 300ms;">
            <p class="label-t ledger-foot">{{ section.settings.footnote }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

