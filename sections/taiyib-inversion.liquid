<section id="inversion" class="t-sheet" aria-labelledby="inversion-heading">
  <div class="t-gutter">
    <div class="t-sheet__row">
      <div class="reveal t-sheet__aside">
        <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
        <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
      </div>

      <div class="t-sheet__body">
        <div class="reveal">
          <h2 id="inversion-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
        </div>

        <div class="t-stack t-mt-lead">
          {%- for block in section.blocks -%}
            <div class="reveal" style="--reveal-delay: {{ forloop.index | times: 100 }}ms;" {{ block.shopify_attributes }}>
              <p class="prose-t t-prose">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {% comment %}
    Runs edge to edge, outside the gutter. A purpose-shot wide frame, so the
    21:9 band is the composition rather than a crop of a full-length figure.
  {% endcomment %}
  <div class="reveal is-image bleed" style="--reveal-delay: 200ms;">
    {% render 'taiyib-plate',
      image: section.settings.image,
      fallback: 'taiyib-figure-bleed.png',
              width: 1024,
              height: 439,
      alt: section.settings.image_alt,
      caption: section.settings.image_caption,
      ratio_class: 'aspect-bleed',
      show_caption: true,
      caption_class: 'caption-gutter',
      sizes: '100vw'
    %}
  </div>
</section>

{% schema %}
{
  "name": "TAIYIB inversion",
  "settings": [
    {
      "type": "text",
      "id": "numeral",
      "label": "Numeral",
      "default": "I"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "The Inversion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The thobe, finally tailored."
    },
    {
      "type": "header",
      "content": "Full-bleed plate"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "A man in a full-length black thobe walking through a vast dark hall, his hem caught mid-stride, lit by a single hard source from the far left."
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "Image — figure in motion, full length"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TAIYIB inversion",
      "blocks": [
        {
          "type": "paragraph",
          "settings": {
            "text": "<p>A man in London flies to Jeddah and brings thobes home in his luggage. That has been the direction of travel for as long as anyone has been buying them.</p>"
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "<p>TAIYIB reverses it. The garment is cut in Milan, by the hands that have spent four hundred years learning how to build a shoulder, and sold back to the men who invented it.</p>"
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "<p>The thobe is not redesigned. The length, the stand collar, the placket, the fall — untouched. What changes is the cloth and the hand.</p>"
          }
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "paragraph",
        "settings": {
          "text": "<p>A man in London flies to Jeddah and brings thobes home in his luggage. That has been the direction of travel for as long as anyone has been buying them.</p>"
        }
      },
      {
        "type": "paragraph",
        "settings": {
          "text": "<p>TAIYIB reverses it. The garment is cut in Milan, by the hands that have spent four hundred years learning how to build a shoulder, and sold back to the men who invented it.</p>"
        }
      },
      {
        "type": "paragraph",
        "settings": {
          "text": "<p>The thobe is not redesigned. The length, the stand collar, the placket, the fall — untouched. What changes is the cloth and the hand.</p>"
        }
      }
    ]
  }
}
{% endschema %}
