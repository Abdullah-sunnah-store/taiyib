<section id="laws" class="t-sheet" aria-labelledby="laws-heading">
  <div class="t-gutter">
    <div class="t-sheet__row">
      <div class="reveal t-sheet__aside">
        <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
        <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
      </div>

      <div class="t-sheet__body">
        <div class="reveal">
          <h2 id="laws-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
        </div>

        <div class="reveal" style="--reveal-delay: 120ms;">
          <ol class="laws">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="label-t laws__numeral" aria-hidden="true">
                  {{- block.settings.numeral | escape -}}
                </span>
                <p class="laws__text">{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TAIYIB laws",
  "settings": [
    {
      "type": "text",
      "id": "numeral",
      "label": "Numeral",
      "default": "VI"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "The Laws"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four rules the house cannot break."
    }
  ],
  "blocks": [
    {
      "type": "law",
      "name": "Law",
      "settings": [
        {
          "type": "text",
          "id": "numeral",
          "label": "Numeral",
          "default": "I"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TAIYIB laws",
      "blocks": [
        {
          "type": "law",
          "settings": {
            "numeral": "I",
            "text": "The price does not move. There is no sale, no code, no outlet, no Ramadan promotion."
          }
        },
        {
          "type": "law",
          "settings": {
            "numeral": "II",
            "text": "No face is used to sell a garment. No name is borrowed. The work stands on its own account."
          }
        },
        {
          "type": "law",
          "settings": {
            "numeral": "III",
            "text": "There is no season. Nothing is discontinued, and so nothing is new."
          }
        },
        {
          "type": "law",
          "settings": {
            "numeral": "IV",
            "text": "The house does not persuade. The specification is the argument."
          }
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "law",
        "settings": {
          "numeral": "I",
          "text": "The price does not move. There is no sale, no code, no outlet, no Ramadan promotion."
        }
      },
      {
        "type": "law",
        "settings": {
          "numeral": "II",
          "text": "No face is used to sell a garment. No name is borrowed. The work stands on its own account."
        }
      },
      {
        "type": "law",
        "settings": {
          "numeral": "III",
          "text": "There is no season. Nothing is discontinued, and so nothing is new."
        }
      },
      {
        "type": "law",
        "settings": {
          "numeral": "IV",
          "text": "The house does not persuade. The specification is the argument."
        }
      }
    ]
  }
}
{% endschema %}
