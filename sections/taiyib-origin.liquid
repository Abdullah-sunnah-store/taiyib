{% comment %}
  Separation is by 1px --grafite hairlines only. The cells are transparent
  rather than filled with --nero, so the ambient light passes behind them —
  an opaque fill masks the glow and makes each cell read as a card.
{% endcomment %}
<section id="origin" class="t-sheet" aria-labelledby="origin-heading">
  <div class="t-gutter">
    <div class="t-sheet__row">
      <div class="reveal t-sheet__aside">
        <div class="label-t t-numeral">{{ section.settings.numeral | escape }}</div>
        <div class="label-t t-seclabel">{{ section.settings.label | escape }}</div>
      </div>

      <div class="t-sheet__body">
        <div class="reveal">
          <h2 id="origin-heading" class="t-headline">{{ section.settings.heading | escape }}</h2>
        </div>

        <div class="reveal t-mt-lead" style="--reveal-delay: 100ms;">
          <p class="prose-t t-prose">{{ section.settings.intro }}</p>
        </div>

        <div class="reveal t-mt-block" style="--reveal-delay: 200ms;">
          <div class="mills">
            {%- for block in section.blocks -%}
              <div class="mills__cell" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.place | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TAIYIB origin",
  "settings": [
    {
      "type": "text",
      "id": "numeral",
      "label": "Numeral",
      "default": "V"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything is declared."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>There is no proprietary blend and no unnamed supplier. If we cannot say where a material came from, we do not use it.</p>"
    }
  ],
  "blocks": [
    {
      "type": "mill",
      "name": "Mill",
      "settings": [
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "Biella"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "mill",
        "settings": {
          "place": "Biella",
          "text": "Piemonte. Wool-silk, wool-crepe, high-twist worsted. Spun and finished in soft alpine water."
        }
      },
      {
        "type": "mill",
        "settings": {
          "place": "Brianza",
          "text": "Lombardia. Cutting and hand-canvassing. Eleven tailors. No line, no automation."
        }
      },
      {
        "type": "mill",
        "settings": {
          "place": "Como",
          "text": "Lombardia. Silk facings for the Notte placket and stand."
        }
      },
      {
        "type": "mill",
        "settings": {
          "place": "Grasse",
          "text": "Provence. Extraction and maturation of TĪB."
        }
      }
    ]
  }
}
{% endschema %}
